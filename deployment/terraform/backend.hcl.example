# Copy to backend.hcl (git-ignored) and fill in the bootstrap storage account.
# Both roots use the same storage account and container. Each environment has
# its own state key, which scripts/infra.sh sets.
resource_group_name  = "rg-english-quest-tfstate"
storage_account_name = "REPLACE_WITH_STATE_STORAGE_ACCOUNT"
container_name       = "tfstate"
use_azuread_auth     = true
