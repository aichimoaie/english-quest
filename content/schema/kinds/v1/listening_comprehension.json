{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "english-quest/exercise-kind/listening_comprehension/v1",
  "title": "Listening comprehension v1",
  "x-kind": "listening_comprehension",
  "x-kind-version": 1,
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "options",
        "question"
      ],
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "answer_key": {
      "type": "object",
      "required": [
        "correct_option_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "correct_option_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        },
        "misconceptions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "selected_option_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "selected_option_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        }
      }
    }
  }
}
