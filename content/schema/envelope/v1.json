{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "english-quest/exercise-envelope/v1",
  "title": "Exercise envelope v1",
  "type": "object",
  "required": [
    "id",
    "kind",
    "kind_version",
    "status",
    "instructions",
    "topics",
    "points",
    "content",
    "answer_key"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ex_[a-z0-9_]+$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "kind_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "retired"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "topic",
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z_]+)+$"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "content": {
      "type": "object"
    },
    "answer_key": {
      "type": "object"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 300
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "role": {
            "enum": [
              "audio_prompt",
              "image",
              "reference_audio"
            ]
          }
        }
      }
    }
  }
}
