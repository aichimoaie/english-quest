# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Production values come from Azure Key Vault, never from this file.

# API settings (read by apps/api/src/english_quest_api/config.py)
DATABASE_URL=postgresql+psycopg://english_quest:english_quest@localhost:5432/english_quest
# Comma-separated list of web origins allowed to call the API with cookies.
# Each must be exactly scheme://host[:port]; the API refuses to start otherwise (no "*").
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used by compose.yaml for the local PostgreSQL container.
POSTGRES_PASSWORD=english_quest
